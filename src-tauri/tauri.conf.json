{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRAFIPLOT Studio",
  "version": "1.2.0",
  "identifier": "com.grafiplot.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GRAFIPLOT — Estudio de impresión",
        "width": 1440,
        "height": 940,
        "minWidth": 1060,
        "minHeight": 700,
        "backgroundColor": "#111318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/grafiplot-engine"],
    "fileAssociations": [
      { "ext": ["pdf"], "name": "Documento PDF", "role": "Editor" }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
